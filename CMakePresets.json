{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
    "configurePresets": [
        {
            "name": "vs2026",
            "displayName": "Visual Studio 2026 x64 (native placeholder UI, WebView2 OFF)",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "TOIRE76_WEBVIEW2": "OFF"
            }
        },
        {
            "name": "vs2026-web",
            "displayName": "Visual Studio 2026 x64 (WebView2 frontend)",
            "inherits": "vs2026",
            "cacheVariables": {
                "TOIRE76_WEBVIEW2": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug",       "configurePreset": "vs2026",     "configuration": "Debug" },
        { "name": "release",     "configurePreset": "vs2026",     "configuration": "Release" },
        { "name": "debug-web",   "configurePreset": "vs2026-web", "configuration": "Debug" },
        { "name": "release-web", "configurePreset": "vs2026-web", "configuration": "Release" }
    ]
}
